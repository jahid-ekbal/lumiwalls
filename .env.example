# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema files in "/src/lib/env"
# directory should be updated accordingly.

# Pooled connection for your application (hostname contains -pooler)
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct connection for Prisma CLI (migrations, studio)
DIRECT_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Disable Prisma telemetry
CHECKPOINT_DISABLE=1

# Better Auth Secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here-replace-with-generated-value

# Better Auth Base URL
BETTER_AUTH_URL=http://localhost:3000

# Better Auth Allowed Origins (comma-separated)
BETTER_AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.X.XX

# Disable Better Auth telemetry
BETTER_AUTH_TELEMETRY=0

# S3-compatible storage (e.g. Backblaze B2, Cloudflare R2, AWS S3)
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=us-eu-central-003
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=your-bucket-name

# Optional public URL base for direct image access
# S3_PUBLIC_URL=https://f002.backblazeb2.com/file/your-bucket-name
# NEXT_PUBLIC_S3_PUBLIC_URL=https://f002.backblazeb2.com/file/your-bucket-name
